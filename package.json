{
  "name": "alterlab-connect",
  "version": "2.2.0",
  "private": true,
  "description": "AlterLab Connect browser extension (Chrome + Firefox) - build tooling and tests",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "clean": "rm -rf dist",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"chrome-extension/tests/*.test.mjs\" \"extension-tests/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
