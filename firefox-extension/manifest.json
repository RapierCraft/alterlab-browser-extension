{
  "manifest_version": 3,
  "name": "AlterLab Connect",
  "version": "2.2.0",
  "description": "Developer tools for web scraping — page analysis, cookie capture, and authenticated scraping with AlterLab",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "scripting"
  ],
  "optional_permissions": [
    "webRequest"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "AlterLab Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "consent.js",
      "privacy.js",
      "connect.js",
      "getapi.js",
      "hands-approvals.js",
      "hands-credentials.js",
      "hands-local.js",
      "recorder.js",
      "byos-refresh.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connect@alterlab.io",
      "strict_min_version": "128.0"
    }
  }
}
